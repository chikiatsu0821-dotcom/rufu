# ===== 必須 =====
# Minecraft EULA (https://aka.ms/MinecraftEULA) に同意する場合のみ TRUE（./mc setup で設定されます）
EULA=FALSE
# RCON（管理コマンド・バックアップ用）のパスワード（./mc setup で自動生成されます）
RCON_PASSWORD=change-me

# ===== Forge =====
# Minecraft のバージョン（Forge Mod が一番多いのは 1.20.1）
# 1.20.5 以降にする場合は docker-compose.yml の image を itzg/minecraft-server:java21 に変更
MC_VERSION=1.20.1
# Forge のバージョン。空なら推奨版を自動選択（例: 47.3.0）
FORGE_VERSION=
# Java ヒープメモリ。Mod が多いほど必要（目安: 軽め 4G / 普通 6G / 大型 Modpack 8G〜）
MEMORY=6G
MC_PORT=25565
TZ=Asia/Tokyo

# ===== ワールド（./mc world switch で自動更新されます） =====
LEVEL=world
# 新規ワールド作成時のシード（空ならランダム）
SEED=

# ===== Modrinth から自動ダウンロードする Mod（任意） =====
# Modrinth の URL 末尾の名前をカンマ区切りで。起動時に mods/ へ自動で入ります
# 例: MODRINTH_PROJECTS=jei,journeymap,waystones
MODRINTH_PROJECTS=

# ===== server.properties（自動反映） =====
MOTD=rufu Forge Server
DIFFICULTY=normal
MODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=10
ONLINE_MODE=TRUE
PVP=true
# ホワイトリスト（カンマ区切りのプレイヤー名）
ENABLE_WHITELIST=TRUE
WHITELIST=
# OP 権限を付与するプレイヤー名（カンマ区切り）
OPS=

# ===== バックアップ =====
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
