# ===== 必須 =====
# Minecraft EULA (https://aka.ms/MinecraftEULA) に同意する場合のみ TRUE にしてください
EULA=FALSE
# RCON（管理コマンド・バックアップ用）のパスワード。必ず推測されにくい値に変更
RCON_PASSWORD=change-me

# ===== サーバー基本設定 =====
# VANILLA / PAPER / FABRIC / FORGE など
SERVER_TYPE=PAPER
# LATEST または 1.21.4 のようなバージョン指定
MC_VERSION=LATEST
# Java ヒープメモリ（マシンの物理メモリより少なく）
MEMORY=4G
MC_PORT=25565
TZ=Asia/Tokyo

# ===== server.properties（itzg イメージが自動反映） =====
MOTD=rufu Minecraft Server
DIFFICULTY=normal
MODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=10
ONLINE_MODE=TRUE
PVP=true
# ホワイトリスト（カンマ区切りのプレイヤー名）。空なら誰でも参加可
ENABLE_WHITELIST=TRUE
WHITELIST=
# OP 権限を付与するプレイヤー名（カンマ区切り）
OPS=

# ===== Bedrock(統合版) からも参加させたい場合（PAPER のみ） =====
# PLUGINS=https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/spigot,https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/spigot

# ===== バックアップ =====
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
